# Copie para scripts/.env e preencha. O arquivo .env NUNCA vai para o Git.
#   cp scripts/.env.example scripts/.env
#
# No Azure DevOps, estas mesmas variáveis vêm do Variable Group "antes-da-chuva"
# (marque as senhas e chaves como secretas).

# ---------- Identificação ----------
# RM de quem administra a assinatura; entra no nome dos recursos que precisam ser únicos no Azure
RM=000000
LOCATION=brazilsouth
# Região do Container Registry. Precisa ter ACR Tasks (brazilsouth tem; chilecentral não)
ACR_LOCATION=brazilsouth

# ---------- PostgreSQL (Azure Database for PostgreSQL Flexible Server) ----------
DB_ADMIN_USER=adminchuva
# Mínimo 8 caracteres, com maiúscula, minúscula e número
DB_ADMIN_PASSWORD=

# ---------- RabbitMQ (Azure Container Instances) ----------
RABBITMQ_USERNAME=chuva
RABBITMQ_PASSWORD=

# ---------- Aplicação ----------
# Gere com: openssl rand -base64 48
JWT_SECRET=
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash

# ---------- Opcional ----------
# Libera o IP desta máquina no firewall do PostgreSQL (para rodar SELECT no vídeo)
ALLOW_MY_IP=true
